# How every shipped SVG and page in this repository is drawn. Checked by
# lasermade-tools' repro-svg; $OUT is where the file must be written.
#
# octagonal_flute names its own sheet, so it writes into $OUT's directory and
# the tool compares the file it asked for. The programs are Rust since
# 2026-11-07, built by repro-svg before these run; the crate borrows from
# square-flute, four-hole-ocarinas, swept-curve and bore-tmm, so all five are
# expected side by side.

# --- the cut file ---
cut-files/octagonal-flute-D4-sheet1-cut-files.svg :: target/release/octagonal_flute --out=$(dirname $OUT)

# --- the preview, from the cut file ---
previews/octagonal-flute-D4-sheet1-cut-files.svg :: ../lasermade-tools/target/release/make-preview cut-files/octagonal-flute-D4-sheet1-cut-files.svg $OUT

# --- the page ---
viewer.js :: target/release/page_assets --viewer-to=$OUT
turn.html :: target/release/page_assets --turn-to=$OUT
plans/octagonal-flute-top-wall.svg :: target/release/page_assets --plans-to=$(dirname $OUT)
plans/octagonal-flute-fingering.svg :: target/release/page_assets --plans-to=$(dirname $OUT)
index.html :: ../lasermade-tools/target/release/md2html README.md $OUT

# --- the SolidCraft design, written by the generator; the design as SolidCraft
# opens it, its build cache left out (lasermade-tools' sc-slim); and the STEP
# file SolidCraft builds from it ---
solidcraft/octagonal-flute-d4.solidcraft.json :: target/release/octagonal_flute --no-write --solidcraft=$(dirname $OUT)
solidcraft/octagonal-flute-d4.sc :: target/release/octagonal_flute --no-write --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/octagonal-flute-d4.solidcraft.json --save $OUT --quiet && ../lasermade-tools/target/release/sc-slim $OUT
step/octagonal-flute-octagonal-flute-d4.step :: target/release/octagonal_flute --no-write --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/octagonal-flute-d4.solidcraft.json --out $OUT --quiet
